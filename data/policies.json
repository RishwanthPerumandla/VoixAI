  "complaint_handling": {
    "severity_levels": {
      "low": {
        "description": "Minor issue, customer not upset",
        "response": "acknowledge_fix",
        "offer": "small_discount"
      },
      "medium": {
        "description": "Noticeable problem, customer frustrated",
        "response": "empathy_action",
        "offer": "free_side_or_discount"
      },
      "high": {
        "description": "Serious issue, customer angry",
        "response": "empathy_ticket_escalate",
        "offer": "refund_or_remake",
        "create_ticket": true
      }
    },
    "common_issues": {
      "wrong_order": "Apologize, remake immediately, offer free side",
      "cold_food": "Apologize, remake, offer discount on next visit",
      "missing_items": "Apologize, add to order immediately, offer free dip",
      "quality_issues": "Apologize, create ticket, offer refund or remake",
      "rude_staff": "Apologize, escalate to manager immediately"
    }
  },
  "escalation": {
    "auto_escalate_triggers": [
