        "kwargs": {
          "item_name": "8 piece classic combo",
          "flavors": "hot"
        },
        "response_contains": [
          "I still need:",
          "drink selection",
          "side selection"
        ]
      },
      {
        "tool": "remove_order_item",
        "kwargs": {
          "item_name": "8 Piece Classic Wing Combo"
        }
      },
      {
        "tool": "add_menu_item",
        "kwargs": {
          "item_name": "8 Classic Wings",
          "flavors": "hot",
          "modifiers": "regular ranch"
        },
        "response_contains": [
          "8 Classic Wings"
        ]
      },
      {
        "tool": "price_order",
        "kwargs": {},
        "response_contains": [
          "total is $12.44"
        ]
      },
      {
        "tool": "review_order_for_confirmation",
        "kwargs": {},
        "response_contains": [
          "8 Classic Wings",
          "Original Hot",
          "Ranch",
          "Rishi"
        ]
      },
      {
        "tool": "set_confirmation_status",
        "kwargs": {
          "confirmed": true
        }
      },
      {
        "tool": "create_mock_order",
        "kwargs": {},
        "response_contains": [
          "Great, your order was placed."
        ]
      }
    ],
    "expected": {
      "order_type": "pickup",
      "customer_name": "Rishi",
      "line_count": 1,
      "line_item_ids": [
        "classic_8"
      ],
      "line_flavor_ids": [
        [
          "original_hot"
        ]
      ],
      "line_modifier_ids": [
        [
          "ranch"
        ]
      ],
      "total": "$12.44",
      "status": "submitted",
      "confirmed": true,
      "validation_errors": []
    }
  },
