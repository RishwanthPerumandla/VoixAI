        }
      },
      {
        "tool": "add_menu_item",
        "kwargs": {
          "item_name": "8 classic wings",
          "flavors": "original hot",
          "modifiers": "ranch"
        }
      },
      {
        "tool": "update_last_item",
        "kwargs": {
          "flavors": "",
          "add_modifiers": "",
          "remove_modifiers": "",
          "special_instructions": ""
        },
        "response_not_contains": [
          "Please choose a flavor for your wings."
        ]
      },
      {
        "tool": "price_order",
        "kwargs": {},
        "response_contains": [
          "Subtotal is",
          "total is $12.44"
        ]
      },
      {
        "tool": "review_order_for_confirmation",
        "kwargs": {},
        "response_contains": [
          "Original Hot",
          "Ranch",
          "Should I place it?"
        ]
      },
      {
        "tool": "set_confirmation_status",
        "kwargs": {
          "confirmed": true
        }
      },
      {
        "tool": "create_mock_order",
        "kwargs": {},
        "response_contains": [
