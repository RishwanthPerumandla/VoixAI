[
  {
    "name": "pickup_wings_flow_survives_blank_follow_up_update",
    "description": "An 8 piece classic wings order keeps its flavor after a later blank update call and can still be priced, reviewed, confirmed, and submitted.",
    "steps": [
      {
        "tool": "set_order_type",
        "kwargs": {
          "order_type": "pickup"
        }
      },
      {
        "tool": "set_customer_details",
        "kwargs": {
          "customer_name": "Rishi"
        }
      },
      {
        "tool": "add_menu_item",
        "kwargs": {
          "item_name": "8 classic wings",
          "flavors": "original hot",
          "modifiers": "ranch"
        }
      },
      {
        "tool": "update_last_item",
        "kwargs": {
          "flavors": "",
          "add_modifiers": "",
          "remove_modifiers": "",
          "special_instructions": ""
        },
        "response_not_contains": [
          "Please choose a flavor for your wings."
        ]
      },
      {
        "tool": "price_order",
        "kwargs": {},
        "response_contains": [
          "Subtotal is",
          "total is $12.44"
        ]
      },
      {
        "tool": "review_order_for_confirmation",
        "kwargs": {},
        "response_contains": [
          "Original Hot",
          "Ranch",
          "Should I place it?"
        ]
      },
      {
        "tool": "set_confirmation_status",
        "kwargs": {
          "confirmed": true
        }
      },
      {
        "tool": "create_mock_order",
        "kwargs": {},
        "response_contains": [
          "Great, your order was placed."
        ]
      }
    ],
    "expected": {
      "order_type": "pickup",
      "customer_name": "Rishi",
      "line_count": 1,
      "line_item_ids": [
        "classic_8"
      ],
      "line_flavor_ids": [
        [
          "original_hot"
        ]
      ],
      "line_modifier_ids": [
        [
          "ranch"
        ]
      ],
      "total": "$12.44",
      "status": "submitted",
      "confirmed": true,
      "validation_errors": []
    }
  },
  {
    "name": "combo_to_wings_correction_preserves_order_integrity",
    "description": "A customer starts with an 8 piece classic combo, then switches to wings-only with ranch. The corrected order must price and submit cleanly.",
    "steps": [
      {
        "tool": "set_order_type",
        "kwargs": {
          "order_type": "pickup"
        }
      },
      {
        "tool": "set_customer_details",
        "kwargs": {
          "customer_name": "Rishi"
        }
      },
      {
