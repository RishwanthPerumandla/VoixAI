[
  {
    "name": "transcript_looping_checkout_places_once",
    "description": "Checkout loop regression: a real 50-wing pickup order for Cherry should place once instead of stalling.",
    "tags": ["transcript_regressions", "checkout_loops", "confirmation_gate", "pricing_repricing"],
    "initial_state": {},
    "turns": [
      {
        "user": "This is pickup for Cherry."
      },
      {
        "user": "Add 50 boneless wings with lemon pepper and original hot.",
        "expected": {
          "contains_items": ["boneless_50"]
        }
      },
      {
        "user": "What's my total?",
        "expected": {
          "telemetry_events": ["price_quoted"],
          "total_present": true
        }
      },
      {
        "user": "Review the order.",
        "expected": {
          "telemetry_events": ["confirmation_review_ready"],
          "response_contains": ["Should I place it?"]
        }
      },
      {
        "user": "Yes, place it.",
        "expected": {
          "telemetry_events": ["mock_order_created"],
          "order_id_created": true,
          "response_contains": ["order was placed"]
        }
      }
    ],
    "final_expected": {
      "status": "completed",
      "line_item_ids": ["boneless_50"],
      "completed_order": true
    }
  },
