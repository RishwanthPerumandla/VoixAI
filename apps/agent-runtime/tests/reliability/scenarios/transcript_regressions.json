    "initial_state": {
      "order_type": "pickup",
      "customer_name": "Cherry",
      "items": [
        {
          "line_id": "line-1",
          "item_id": "classic_10",
          "quantity": 1,
          "selected_flavor_ids": ["plain"],
          "selected_modifier_ids": [],
          "notes": ""
        }
      ]
    },
    "turns": [
      {
        "user": "Actually make that 10 boneless wings.",
        "expected": {
          "contains_items": ["boneless_10"]
        }
      },
      {
