# ============================================
# VoixAI v3.0 - Environment Configuration
# Copy this file to .env and fill in your API keys
# ============================================

# --------------------------------------------
# AI/ML API Keys (Required)
# --------------------------------------------

# Groq API for LLM inference
# Get yours at: https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# Deepgram API for Speech-to-Text
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=dg_your_key_here

# Cartesia API for Text-to-Speech
# Get yours at: https://cartesia.ai/
CARTESIA_API_KEY=your_key_here

# Daily.co API for WebRTC transport
# Get yours at: https://dashboard.daily.co/
DAILY_API_KEY=your_key_here

# --------------------------------------------
# Local Services Configuration
# --------------------------------------------

# Redis (local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant (local Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# SQLite Database (local file)
DATABASE_PATH=data/voixai.db

# --------------------------------------------
# Application Settings
# --------------------------------------------

# Logging level
LOG_LEVEL=INFO

# Application port
PORT=8000

# Environment
ENVIRONMENT=development

# --------------------------------------------
# Feature Flags (Local Development)
# --------------------------------------------

# Enable/disable interruptions
ENABLE_INTERRUPTIONS=true

# Enable TTS caching
ENABLE_TTS_CACHE=true

# Enable vector search
ENABLE_VECTOR_SEARCH=true
