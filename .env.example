# Shared local development placeholders
# Manual runs use these directly.
# `docker compose` overrides the LiveKit connection details with the bundled
# local LiveKit service (`ws://localhost:7880`, key `devkey`, secret `secret`).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
OPENAI_API_KEY=
GOOGLE_API_KEY=
AGENT_NAME=my-agent
VOICE_PROVIDER=openai_realtime
LLM_MODEL=openai/gpt-5.3-chat-latest
STT_MODEL=deepgram/flux-general
STT_LANGUAGE=en
TTS_MODEL=cartesia/sonic-3
TTS_SPEED=1.08
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_EAGERNESS=medium
GOOGLE_REALTIME_MODEL=gemini-3.1-flash-live-preview
GOOGLE_REALTIME_VOICE=Achird
REALTIME_TEMPERATURE=0.6

# Local service ports
WEB_PORT=3000
API_PORT=8000

# Where the agent runtime posts call telemetry for the dashboard.
# Defaults to the local API service; override in deployment.
VOIXAI_API_URL=http://127.0.0.1:8000

# API persistence. Leave DATABASE_URL empty for local SQLite at .voixai/voixai.db,
# or set it to a Postgres URL for dev/prod.
DATABASE_URL=
VOIXAI_DB_PATH=.voixai/voixai.db

# Recording toggle (Phase 5).
ENABLE_RECORDING=false
# EGRESS_S3_BUCKET=voixai-recordings
# EGRESS_S3_ENDPOINT=http://localhost:9000
# EGRESS_S3_ACCESS_KEY=minioadmin
# EGRESS_S3_SECRET_KEY=minioadmin
